import numpy as np
import matplotlib.pyplot as plt
import time
from sklearn.datasets import fetch_openml
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score

# Load Fashion MNIST
print("Loading dataset...")
data = fetch_openml("Fashion-MNIST", version=1, as_frame=False)

X = data.data / 255.0
y = data.target.astype(int)

# Use smaller dataset for faster execution
X_train = X[:10000]
y_train = y[:10000]

X_test = X[60000:62000]
y_test = y[60000:62000]

# K values
k_values = [1, 3, 5, 7, 9]

accuracies = []
prediction_times = []

print("-" * 40)
print(f"{'K':<5}{'Accuracy':<15}{'Time (s)'}")
print("-" * 40)

for k in k_values:

    knn = KNeighborsClassifier(n_neighbors=k)
    knn.fit(X_train, y_train)

    start = time.time()
    y_pred = knn.predict(X_test)
    end = time.time()

    accuracy = accuracy_score(y_test, y_pred)
    pred_time = end - start

    accuracies.append(accuracy)
    prediction_times.append(pred_time)

    print(f"{k:<5}{accuracy:.4f}          {pred_time:.4f}")

# Best K
best_index = np.argmax(accuracies)

print("-" * 40)
print("Best K:", k_values[best_index])
print("Best Accuracy:", round(accuracies[best_index], 4))

# Graphs
plt.figure(figsize=(12, 5))

# Accuracy graph
plt.subplot(1, 2, 1)
plt.plot(k_values, accuracies, marker='o', color='blue')

plt.title("Accuracy vs K Value")
plt.xlabel("K Value")
plt.ylabel("Accuracy")
plt.xticks(k_values)
plt.grid(True)

for k, acc in zip(k_values, accuracies):
    plt.text(k, acc + 0.005, f"{acc:.4f}", ha='center')

# Time graph
plt.subplot(1, 2, 2)
plt.plot(k_values, prediction_times, marker='o', color='red')

plt.title("Prediction Time vs K Value")
plt.xlabel("K Value")
plt.ylabel("Time (seconds)")
plt.xticks(k_values)
plt.grid(True)

for k, t in zip(k_values, prediction_times):
    plt.text(k, t, f"{t:.2f}s", ha='center')

plt.tight_layout()
plt.show()
