import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans, AgglomerativeClustering
from sklearn.metrics import silhouette_score


# Load dataset
df = pd.read_csv("Mall_Customers.csv")

print("Dataset Preview:")
print(df.head())

print("\nDataset Information:")
df.info()


# Select features
X = df[["Annual Income (k$)", "Spending Score (1-100)"]]

# Standardize the data
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)


# =========================================================
# K-MEANS CLUSTERING
# =========================================================

k_scores = []

for k in range(2, 11):
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    labels = model.fit_predict(X_scaled)
    k_scores.append(silhouette_score(X_scaled, labels))


# Plot K-Means silhouette scores
plt.plot(range(2, 11), k_scores, marker="o")
plt.xlabel("Number of Clusters (K)")
plt.ylabel("Silhouette Score")
plt.title("K-Means Silhouette Score")
plt.show()


# Apply K-Means with 5 clusters
kmeans = KMeans(n_clusters=5, random_state=42, n_init=10)
k_labels = kmeans.fit_predict(X_scaled)

# Calculate inertia
k_inertia = kmeans.inertia_

# Calculate silhouette score
k_silhouette = silhouette_score(X_scaled, k_labels)

print("\nK-Means Inertia:", k_inertia)
print("K-Means Silhouette Score:", k_silhouette)


# =========================================================
# AGGLOMERATIVE CLUSTERING
# =========================================================

a_scores = []

for k in range(2, 11):
    model = AgglomerativeClustering(
        n_clusters=k,
        linkage="ward"
    )
    labels = model.fit_predict(X_scaled)
    a_scores.append(silhouette_score(X_scaled, labels))


# Plot Agglomerative silhouette scores
plt.plot(range(2, 11), a_scores, marker="o")
plt.xlabel("Number of Clusters (K)")
plt.ylabel("Silhouette Score")
plt.title("Agglomerative Silhouette Score")
plt.show()


# Apply Agglomerative Clustering with 5 clusters
agg = AgglomerativeClustering(
    n_clusters=5,
    linkage="ward"
)

a_labels = agg.fit_predict(X_scaled)

# Calculate silhouette score
a_silhouette = silhouette_score(X_scaled, a_labels)

print("Agglomerative Silhouette Score:", a_silhouette)


# =========================================================
# K-MEANS CLUSTER VISUALIZATION
# =========================================================

plt.scatter(
    X.iloc[:, 0],
    X.iloc[:, 1],
    c=k_labels,
    s=50
)

plt.xlabel("Annual Income (k$)")
plt.ylabel("Spending Score (1-100)")
plt.title("K-Means Customer Clusters")
plt.show()


# =========================================================
# AGGLOMERATIVE CLUSTER VISUALIZATION
# =========================================================

plt.scatter(
    X.iloc[:, 0],
    X.iloc[:, 1],
    c=a_labels,
    s=50
)

plt.xlabel("Annual Income (k$)")
plt.ylabel("Spending Score (1-100)")
plt.title("Agglomerative Customer Clusters")
plt.show()


# =========================================================
# COMPARISON
# =========================================================

comparison = pd.DataFrame({
    "Algorithm": ["K-Means", "Agglomerative"],
    "Inertia": [k_inertia, np.nan],
    "Silhouette Score": [k_silhouette, a_silhouette]
})

print("\nComparison Table:")
print(comparison.to_string(index=False))
