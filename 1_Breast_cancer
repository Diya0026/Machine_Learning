import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import load_breast_cancer
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression

# 1. Load & Split Data
data = load_breast_cancer()
X_train, X_test, y_train, y_test = train_test_split(data.data, data.target, test_size=0.2, random_state=42)

# 2. Standardize Features
scaler = StandardScaler()
X_train = scaler.fit_transform(X_train)
X_test = scaler.transform(X_test)

# 3. Train Models
mle = LogisticRegression(C=np.inf, solver='lbfgs').fit(X_train, y_train)
l1 = LogisticRegression(l1_ratio=1.0, solver='saga', max_iter=10000).fit(X_train, y_train)
l2 = LogisticRegression(l1_ratio=0.0, solver='lbfgs').fit(X_train, y_train)

# 4. Print Accuracies
print("MLE Accuracy:", mle.score(X_test, y_test))
print("MAP (L1) Accuracy:", l1.score(X_test, y_test))
print("MAP (L2) Accuracy:", l2.score(X_test, y_test))

# GRAPH 1: Three Separate LINE Graphs (Side-by-Side)

fig, axes = plt.subplots(1, 3, figsize=(15, 4))

# 1. MLE Line Graph
axes[0].plot(mle.coef_[0][:10], 'o-', color='blue')
axes[0].set_title("MLE (Unregularized)")
axes[0].axhline(0, color='red', linestyle='--')
axes[0].set_ylabel("Coefficient Value")

# 2. MAP L1 Line Graph
axes[1].plot(l1.coef_[0][:10], 's-', color='orange')
axes[1].set_title("MAP (L1 Regularization)")
axes[1].axhline(0, color='red', linestyle='--')
axes[1].set_xlabel("Feature Index")

# 3. MAP L2 Line Graph
axes[2].plot(l2.coef_[0][:10], '^-', color='green')
axes[2].set_title("MAP (L2 Regularization)")
axes[2].axhline(0, color='red', linestyle='--')

plt.suptitle("Individual Coefficient Line Plots (First 10 Features)")
plt.tight_layout()
plt.show()


# GRAPH 2: Single Combined BAR Graph (All Three Together)

plt.figure(figsize=(10, 5))

x = np.arange(10)  # First 10 features (indices 0 to 9)
width = 0.25       # Width of each bar

plt.bar(x - width, mle.coef_[0][:10], width, label='MLE', color='blue')
plt.bar(x, l1.coef_[0][:10], width, label='MAP L1', color='orange')
plt.bar(x + width, l2.coef_[0][:10], width, label='MAP L2', color='green')

plt.axhline(0, color='red', linestyle='--', linewidth=0.8)
plt.title("Combined Bar Graph Comparison of Coefficients")
plt.xlabel("Feature Index")
plt.ylabel("Coefficient Value")
plt.xticks(x)
plt.legend()
plt.grid(axis='y', linestyle=':', alpha=0.6)
plt.tight_layout()
plt.show()
